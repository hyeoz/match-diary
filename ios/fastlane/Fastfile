# GitHub Actions(.github/workflows/testflight.yml)에서 `bundle exec fastlane beta`로 돈다.
# 필요한 환경 변수: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8, DIST_CERT_PATH, IOS_DIST_CERT_PASSWORD
default_platform(:ios)

APP_ID = "com.matchdirary.app"
PROJECT = "matchdiary.xcodeproj"

platform :ios do
  desc "Release 빌드를 만들어 테스트플라이트에 올린다"
  lane :beta do
    # CI에서는 임시 키체인을 만든다 (로컬에서는 아무 일도 안 함)
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8")
    )

    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    # 앱스토어 배포용 프로비저닝 프로파일을 받는다 (없으면 만든다)
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: PROJECT,
      targets: ["matchdiary"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      code_sign_identity: "iPhone Distribution",
      profile_name: profile_name
    )

    # 빌드 번호는 테스트플라이트의 마지막 번호 + 1
    build_number = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)

    # Info.plist의 NMFClientId가 빌드 설정 변수로 들어간다
    naver_client_id = File.read("../../.env")[/^REACT_APP_NAVER_MAP_CLIENT_ID=(.*)$/, 1].to_s.strip

    build_app(
      workspace: "matchdiary.xcworkspace",
      scheme: "matchdiary",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile_name } },
      xcargs: "REACT_APP_NAVER_MAP_CLIENT_ID='#{naver_client_id}'",
      output_directory: "build"
    )

    # 업로드만 하고 애플 쪽 처리는 기다리지 않는다
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
