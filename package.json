{
  "name": "matchdiary",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "ios": "react-native run-ios --simulator=\"iPhone 16\"",
    "ios:debug": "xcodebuild -workspace ios/matchdiary.xcworkspace -scheme matchdiary -configuration Debug -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO build",
    "lint": "eslint App.tsx src/router.tsx src/revival --ext .ts,.tsx",
    "start": "react-native start",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:ci"
  },
  "dependencies": {
    "@notifee/react-native": "^7.8.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native/gradle-plugin": "0.73.4",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "dayjs": "^1.11.10",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs2": "^3.0.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-google-mobile-ads": "14.2.5",
    "react-native-image-picker": "^7.2.3",
    "react-native-keychain": "^8.2.0",
    "react-native-safe-area-context": "^4.9.0",
    "react-native-screens": "3.30.1",
    "react-native-share": "^11.0.4",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.1.0",
    "react-native-view-shot": "^3.8.0",
    "react-native-zip-archive": "^9.4.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.73.6",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "^0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.3.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
