{
  "compilerOptions": {
    "jsx": "react",
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "baseUrl": "./src/",
    "paths": {
      "@/*": ["*"],
      "*": ["*"],
      "@components/*": ["components/*"],
      "@assets/*": ["assets/*"],
      "@pages/*": ["pages/*"],
      "@style/*": ["style/*"],
      "@stores/*": ["stores/*"],
      "@type/*": ["type/*"],
      "@utils/*": ["utils/*"],
      "@api/*": ["api/*"]
    }
  },
  "extends": "@react-native/typescript-config/tsconfig.json",
  "include": [
    "App.tsx",
    "src/router.tsx",
    "src/revival/**/*.ts",
    "src/revival/**/*.tsx",
    "src/assets/svg/index.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/pages",
    "src/components",
    "src/hooks",
    "src/api",
    "src/stores"
  ]
}
